NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/corizo-desk
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
SESSION_TTL_SECONDS=2592000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=2000

RESEND_API_KEY=
EMAIL_FROM=noreply@corizo.in

# Local: http://localhost:5173
# Production frontend:
FRONTEND_URL=https://desk.corizo.in
# FRONTEND_URLS=https://desk.corizo.in,https://corizo-desk-frontend.vercel.app

# Production Redis (Upstash / Redis Cloud) — strongly recommended on Vercel
# Without this, caches fall back to in-memory + Mongo short-lived AppCache.
# REDIS_URL=rediss://default:TOKEN@YOUR-UPSTASH-HOST:6379

# Google Sheets connector (Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
