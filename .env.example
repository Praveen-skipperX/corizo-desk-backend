NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/corizo-desk
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
SESSION_TTL_SECONDS=2592000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=2000

RESEND_API_KEY=
EMAIL_FROM=noreply@corizo.in

# Local: http://localhost:5173
# Production (Vercel): https://your-app.vercel.app
# Multiple origins (previews): comma-separated via FRONTEND_URLS
FRONTEND_URL=http://localhost:5173
# FRONTEND_URLS=https://your-app.vercel.app,https://your-app-git-main-user.vercel.app

# Google Sheets connector (Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
